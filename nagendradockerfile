FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ADD . /tmp/dotnetcode
WORKDIR /tmp/dotnetcode
RUN dotnet publish -c Release src/Presentation/Nop.Web/Nop.Web.csproj -o binaryfolder

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS runtime
LABEL project=dotnetproject
LABEL author=nagendra
COPY --from=build /tmp/dotnetcode/binaryfolder /pavan
WORKDIR /pavan
EXPOSE 5000
CMD ["dotnet","Nop.Web.dll","--urls","http://0.0.0.0:5000"]